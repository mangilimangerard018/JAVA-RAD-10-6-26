import java.util.Scanner;

public class ArithmeticSwitchProgram {
    public static void main(String[] args) {
        Scanner scanner = new Scanner(System.in);

        // Input values for X and Y
        System.out.print("Enter the value for X: ");
        double x = scanner.nextDouble();

        System.out.print("Enter the value for Y: ");
        double y = scanner.nextDouble();

        // Choose the arithmetic operator
        System.out.print("Choose an operator (+, -, *, /): ");
        char operator = scanner.next().charAt(0);

        double result = 0;
        boolean validOperation = true;

        // Switch case statement to perform the chosen calculation
        switch (operator) {
            case '+':
                result = x + y;
                break;
            case '-':
                result = x - y;
                break;
            case '*':
                result = x * y;
                break;
            case '/':
                // Handle division by zero
                if (y != 0) {
                    result = x / y;
                } else {
                    System.out.println("Error: Division by zero is not allowed.");
                    validOperation = false;
                }
                break;
            default:
                System.out.println("Error: Invalid operator chosen.");
                validOperation = false;
                break;
        }

        // Print the result if the operation was valid
        if (validOperation) {
            System.out.println("\nResult: " + x + " " + operator + " " + y + " = " + result);
        }

        scanner.close();
    }
}
